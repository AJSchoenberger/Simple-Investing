<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AUREUS — Clear, Intelligence-Driven Investing</title>
    
    <!-- Single Google Font Link (Optima-esque serif & modern sans body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* -----------------------------------------------------------------
           AESOP-INSPIRED DESIGN SYSTEM
           Palette: Soft Warm Stone (#F6F5F0), Deep Obsidian Charcoal (#1E1E1C),
           Refined Gold (#C5A059), muted Sage Green (#2E5B42), Warm Amber (#E3A857).
        ----------------------------------------------------------------- */
        :root {
            --bg-primary: #F6F5F0;
            --bg-secondary: #EFECE6;
            --bg-card: #FAF9F5;
            --text-primary: #1E1E1C;
            --text-secondary: #5A5955;
            --text-muted: #8C8A84;
            --gold-accent: #C5A059;
            --gold-light: #DFCA9B;
            --gold-soft: #F4EEDD;
            --green-accent: #2A5A3B;
            --green-light: #E7F0EB;
            --green-border: #80B192;
            --border-light: #E2DFD7;
            --border-dark: #2A2A28;
            --font-serif: 'Cinzel', serif;
            --font-sans: 'Plus Jakarta Sans', sans-serif;
            --transition-smooth: cubic-bezier(0.25, 1, 0.5, 1);
        }

        /* Reset & Global */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: var(--font-sans);
            font-weight: 400;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font-family: inherit;
            cursor: pointer;
            border: none;
            background: none;
        }

        /* Top Announcement Ticker */
        .market-bar {
            background-color: var(--text-primary);
            color: var(--bg-primary);
            padding: 8px 24px;
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .market-status {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background-color: #4CAF50;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 8px #4CAF50;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.4; }
            100% { opacity: 1; }
        }

        /* Navigation Header */
        header {
            padding: 24px 48px;
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            border-bottom: 1px solid var(--border-light);
            background-color: var(--bg-primary);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand-title {
            font-family: var(--font-serif);
            font-size: 1.8rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            color: var(--text-primary);
        }

        .brand-subtitle {
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--gold-accent);
            margin-top: -4px;
        }

        nav {
            display: flex;
            gap: 32px;
            font-size: 0.85rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        nav a {
            position: relative;
            padding-bottom: 4px;
            color: var(--text-secondary);
            transition: color 0.3s ease;
        }

        nav a:hover, nav a.active {
            color: var(--text-primary);
        }

        nav a.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background-color: var(--gold-accent);
        }

        /* Hero Section */
        .hero {
            padding: 80px 48px 60px 48px;
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 64px;
            align-items: center;
        }

        .hero-tag {
            font-family: var(--font-serif);
            font-size: 0.85rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--gold-accent);
            margin-bottom: 16px;
            display: block;
        }

        .hero-title {
            font-family: var(--font-serif);
            font-size: 2.8rem;
            font-weight: 400;
            line-height: 1.25;
            letter-spacing: -0.02em;
            margin-bottom: 24px;
            color: var(--text-primary);
        }

        .hero-description {
            font-size: 1.05rem;
            color: var(--text-secondary);
            line-height: 1.7;
            margin-bottom: 32px;
            max-width: 580px;
        }

        .hero-stats-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-light);
            padding: 32px;
            border-radius: 2px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            position: relative;
        }

        .hero-stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 3px;
            height: 100%;
            background-color: var(--gold-accent);
        }

        .card-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .card-stat {
            font-family: var(--font-serif);
            font-size: 2.2rem;
            color: var(--green-accent);
            margin-bottom: 16px;
        }

        /* Beginner Guardrails Banner */
        .guardrail-box {
            background-color: var(--green-light);
            border: 1px solid var(--green-border);
            padding: 16px 20px;
            border-radius: 2px;
            display: flex;
            gap: 16px;
            align-items: flex-start;
            margin-top: 24px;
        }

        .guardrail-icon {
            color: var(--green-accent);
            font-weight: bold;
            font-size: 1.1rem;
            line-height: 1;
        }

        .guardrail-text {
            font-size: 0.85rem;
            color: var(--green-accent);
            line-height: 1.5;
        }

        /* Sector Filter Tabs */
        .section-header-wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 48px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 16px;
            margin-top: 40px;
        }

        .section-title {
            font-family: var(--font-serif);
            font-size: 1.6rem;
            font-weight: 400;
            letter-spacing: 0.05em;
        }

        .sector-pills {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .sector-btn {
            padding: 8px 18px;
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background-color: transparent;
            border: 1px solid var(--border-light);
            color: var(--text-secondary);
            border-radius: 30px;
            transition: all 0.3s ease;
        }

        .sector-btn:hover {
            border-color: var(--gold-accent);
            color: var(--text-primary);
        }

        .sector-btn.active {
            background-color: var(--text-primary);
            color: var(--bg-primary);
            border-color: var(--text-primary);
        }

        .sector-btn .rank-badge {
            font-size: 0.7rem;
            background-color: var(--gold-accent);
            color: white;
            padding: 2px 6px;
            border-radius: 10px;
            margin-right: 6px;
        }

        /* Main Stock Listings */
        .stocks-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 48px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 32px;
        }

        .stock-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-light);
            padding: 32px;
            transition: transform 0.3s var(--transition-smooth), box-shadow 0.3s var(--transition-smooth);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            cursor: pointer;
        }

        .stock-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.05);
            border-color: var(--gold-accent);
        }

        .stock-card-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .stock-ticker {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: 0.05em;
        }

        .stock-name {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .sector-tag {
            font-size: 0.7rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 4px 10px;
            background-color: var(--bg-secondary);
            color: var(--text-secondary);
            border-radius: 2px;
        }

        .price-row {
            display: flex;
            align-items: baseline;
            gap: 12px;
            margin-bottom: 20px;
        }

        .current-price {
            font-size: 1.8rem;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .upside-tag {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--green-accent);
            background-color: var(--green-light);
            padding: 2px 8px;
            border-radius: 2px;
        }

        .layman-summary {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 24px;
            line-height: 1.6;
        }

        .action-plan {
            background-color: var(--bg-secondary);
            padding: 16px;
            border-radius: 2px;
            margin-bottom: 24px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .plan-item {
            display: flex;
            flex-direction: column;
        }

        .plan-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
        }

        .plan-value {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-top: 2px;
        }

        .card-footer-btn {
            width: 100%;
            padding: 12px;
            text-align: center;
            border: 1px solid var(--text-primary);
            font-size: 0.8rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 600;
            transition: all 0.3s ease;
            background-color: transparent;
        }

        .stock-card:hover .card-footer-btn {
            background-color: var(--text-primary);
            color: var(--bg-primary);
        }

        /* News & Market Sentiment Section */
        .news-section {
            max-width: 1200px;
            margin: 80px auto;
            padding: 0 48px;
        }

        .news-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
            margin-top: 24px;
        }

        .news-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-light);
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .news-source {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--gold-accent);
            margin-bottom: 8px;
        }

        .news-title {
            font-family: var(--font-serif);
            font-size: 1.1rem;
            margin-bottom: 12px;
            line-height: 1.4;
        }

        .news-snippet {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .news-impact {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--green-accent);
        }

        /* Interactive Detail Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(30, 30, 28, 0.6);
            backdrop-filter: blur(4px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-card {
            background-color: var(--bg-primary);
            width: 90%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 48px;
            border: 1px solid var(--gold-accent);
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
            position: relative;
            transform: translateY(20px);
            transition: transform 0.3s var(--transition-smooth);
        }

        .modal-overlay.active .modal-card {
            transform: translateY(0);
        }

        .modal-close {
            position: absolute;
            top: 24px;
            right: 24px;
            font-size: 1.5rem;
            color: var(--text-muted);
            cursor: pointer;
            transition: color 0.2s;
        }

        .modal-close:hover {
            color: var(--text-primary);
        }

        .modal-header {
            margin-bottom: 24px;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 16px;
        }

        .modal-ticker {
            font-family: var(--font-serif);
            font-size: 2rem;
            color: var(--gold-accent);
        }

        .modal-company-name {
            font-size: 1.1rem;
            color: var(--text-secondary);
        }

        .modal-section {
            margin-bottom: 24px;
        }

        .modal-section-title {
            font-family: var(--font-serif);
            font-size: 1.1rem;
            margin-bottom: 8px;
            color: var(--text-primary);
            border-left: 2px solid var(--gold-accent);
            padding-left: 12px;
        }

        .modal-text {
            font-size: 0.95rem;
            color: var(--text-secondary);
            line-height: 1.7;
        }

        .sources-list {
            margin-top: 12px;
            padding-left: 20px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .sources-list li {
            margin-bottom: 4px;
        }

        /* Educational Glossary Footer Section */
        .learning-section {
            background-color: var(--bg-secondary);
            padding: 80px 48px;
            margin-top: 80px;
            border-top: 1px solid var(--border-light);
        }

        .learning-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .learning-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 32px;
            margin-top: 32px;
        }

        .concept-card {
            background-color: var(--bg-card);
            padding: 24px;
            border: 1px solid var(--border-light);
        }

        .concept-title {
            font-family: var(--font-serif);
            font-size: 1.1rem;
            margin-bottom: 8px;
            color: var(--gold-accent);
        }

        .concept-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Footer */
        footer {
            background-color: var(--text-primary);
            color: var(--bg-primary);
            padding: 48px;
            text-align: center;
            font-size: 0.8rem;
            border-top: 1px solid var(--border-dark);
        }

        .footer-brand {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            letter-spacing: 0.15em;
            margin-bottom: 12px;
            color: var(--gold-accent);
        }

        .disclaimer {
            max-width: 800px;
            margin: 16px auto 0 auto;
            color: #8C8A84;
            font-size: 0.75rem;
            line-height: 1.6;
        }

        /* Responsive Breakpoints */
        @media (max-width: 900px) {
            header, .hero, .section-header-wrap, .stocks-container, .news-section, .learning-section {
                padding-left: 24px;
                padding-right: 24px;
            }

            .hero {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .news-grid {
                grid-template-columns: 1fr;
            }

            .section-header-wrap {
                flex-direction: column;
                align-items: flex-start;
                gap: 16px;
            }
        }
    </style>
</head>
